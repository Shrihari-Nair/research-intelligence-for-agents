# Copy to .env (git-ignored). Never commit real keys.

# --- required ---
GOOGLE_API_KEY=            # Gemini (LLM, STT/TTS). https://aistudio.google.com/apikey
TAVILY_API_KEY=            # web search. https://tavily.com

# --- optional tool providers (configs/tools.yaml) ---
GITHUB_TOKEN=              # higher GitHub rate limit
NCBI_API_KEY=              # higher PubMed rate limit

# --- runtime switches ---
RESEARCH_OS_TOOLS=live     # live = real web/GitHub/arXiv/PubMed; fixture = canned corpus (default from configs/tools.yaml)
RESEARCH_OS_LLM=           # auto (default) | gemini | demo (offline demo LLM)
RESEARCH_OS_CORS_ORIGINS=  # extra browser origins allowed to call the API, comma separated
RESEARCH_OS_ROUTER_MODEL=  # path to a different trained router (default models/router)
DATABASE_URL=              # Postgres URL for memory; unset = local SQLite file

# --- docker compose (docker-compose.yml) ---
UI_PORT=3201
API_PORT=8010

# --- optional tracing (no-op when unset); local server: docker/langfuse/up.sh ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=             # e.g. http://localhost:3100 or https://cloud.langfuse.com

# --- optional voice demo (scripts/voice_demo.py, see docs/VOICE.md) ---
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
